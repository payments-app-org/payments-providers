<?xml version="1.0" encoding="UTF-8"?>
<!-- Вход в GitHub Packages (там лежит payments-platform): токен — из переменной GITHUB_TOKEN.
     В CI это встроенный токен GitHub Actions, при сборке образа — секрет сборки, локально — gh auth token. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
    <servers>
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
</settings>
