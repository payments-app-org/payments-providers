<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.paymentsapp</groupId>
    <artifactId>providers</artifactId>
    <version>0.1.0</version>
    <name>providers</name>
    <description>Заглушки сторонних поставщиков: ГИС ГМП и другие</description>

    <properties>
        <java.version>21</java.version>
        <platform.version>1.2.0</platform.version>
        <springdoc.version>3.2.0</springdoc.version>
    </properties>

    <!-- Своя библиотека payments-platform — в GitHub Packages (аналог корпоративного Nexus); вход — .mvn/settings.xml -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/payments-app-org/payments-platform</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Общая инфраструктура: outbox, доменные ошибки, DLT, часовой пояс, хэши, блокировки планировщиков -->
        <dependency>
            <groupId>com.paymentsapp</groupId>
            <artifactId>platform</artifactId>
            <version>${platform.version}</version>
        </dependency>
        <!-- Redis: итоги оплат у шлюзов (идемпотентность) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- /actuator/health: пробы liveness и readiness (healthcheck в compose, Kubernetes) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Swagger UI: /swagger-ui.html, спецификация — /v3/api-docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
